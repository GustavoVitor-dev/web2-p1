{
  
  "compilerOptions": {
    
    
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    "outDir": "dist", //diretorio saida dos arquivos para a visualização
    "rootDir": "src",
    
    
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    
    "exactOptionalPropertyTypes": true,

    
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
